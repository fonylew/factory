# Trello Kanban Configuration (Never exposed to `pi` coding agent)
TRELLO_API_KEY="your_trello_api_key_here"
TRELLO_TOKEN="your_trello_oauth_token_here"
TRELLO_BOARD_ID="your_trello_board_id_here"
# Comma-separated list of authorized Trello member IDs allowed to approve 'Human Decision' cards
TRELLO_AUTHORIZED_MEMBERS="member_id_1,member_id_2"

# Git & PR Hosting Configuration (Never exposed to `pi` coding agent)
GITHUB_TOKEN="your_github_pat_here"
GIT_REMOTE_NAME="origin"
GIT_BASE_BRANCH="main"

# Antigravity (agy) & Model Settings
AGY_MODEL="gemini-4-argon"
PI_BINARY_PATH="/home/aimet/.local/bin/pi"
